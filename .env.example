# API Configuration
# Base URL for the backend API
VITE_API_BASE_URL=https://api.tekxai.services/

# Demo login without backend (admin / employee / marketing dashboards)
VITE_USE_MOCK_AUTH=false

# CRM workspace app (tek-pulse-FE) — used by the capability-based
# workspace switcher when the user holds crm.workspace.access.
VITE_CRM_APP_URL=https://tekpulse.tekxai.com/
